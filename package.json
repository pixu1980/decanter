{
  "name": "decanter",
  "version": "0.1.0",
  "private": true,
  "description": "Wrap any Windows-only PC game (Steam, GOG or Epic) into a native macOS .app (Wine + D3DMetal), with a CLI and an OpenTUI interface.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "decanter": "bin/decanter.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "node bin/install-hooks.mjs",
    "changelog": "node bin/changelog.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "pnpm add --global .",
    "start": "node bin/decanter.mjs",
    "test": "node --test tests/unit/*.test.ts",
    "test:tui": "node --experimental-ffi --import tsx --test tests/tui/*.test.tsx",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm test:tui"
  },
  "dependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/react": "0.6.6",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
