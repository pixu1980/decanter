{
  "name": "steam-mac",
  "version": "0.1.0",
  "private": true,
  "description": "Wrap any Windows-only Steam game into a native macOS .app (Wine + D3DMetal), with a CLI and an OpenTUI interface.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "steam-mac": "bin/steam-mac.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node --experimental-ffi --import tsx src/cli.ts",
    "tui": "node --experimental-ffi --import tsx src/cli.ts tui",
    "test": "node --test tests/unit/*.test.ts",
    "test:tui": "node --experimental-ffi --import tsx --test tests/tui/*.test.tsx",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm test:tui"
  },
  "dependencies": {
    "@opentui/core": "0.5.14",
    "@opentui/react": "0.5.14",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
